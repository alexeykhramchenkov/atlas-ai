    "table": "system_ai_answer_rules",
    "semantic_key": "[\"simple\", \"ru\", \"compact_text\", {\"analysis\": \"worst\", \"dataset\": \"funnel\", \"entity\": \"product\", \"metric\": \"carts_without_orders\"}]",
    "changes": {
      "title_template": "<b>Корзины без заказов</b>{period_heading}\n\nЗаказов: <b>0</b>\n\n{items}",
      "fields": [
        {
          "match": {
            "entity": "product",
            "metric": "carts_without_orders",
            "dataset": "funnel",
            "analysis": "worst"
          }
        },
        {
          "template": {
            "rows_path": "rows",
            "empty_text": "Таких товаров за выбранный период не найдено.",
            "item_fields": [
              {
                "name": "title",
                "path": "title",
                "formatter": "html_text"
              },
              {
                "name": "value",
                "path": "value",
                "formatter": "number"
              },
              {
                "name": "cart_word",
                "path": "value",
                "options": {
                  "forms": [
                    "корзина",
                    "корзины",
                    "корзин"
                  ]
                },
                "formatter": "plural"
              }
            ],
            "status_text": {
              "no_data": "За выбранный период данных для этого показателя нет.",
              "no_orders": "За этот период заказов нет, поэтому такой показатель пока не посчитать.",
              "incomplete": "Пока не хватает загруженных данных за весь выбранный период. Числа не буду угадывать.",
              "no_product": "В текущем снимке нет остатков этого товара. Нужна проверка данных WB."
            },
            "item_template": "• {title}: <b>{value}</b> {cart_word}",
            "omit_same_year": true,
            "telegram_format": "html_bold",
            "cancellation_template": "\nИз них отменили <b>{cancelled_count}</b>.",
            "item_cancellation_template": " (отменили <b>{cancelled_count}</b>)"
          }
        },
        {
          "path": "meta.total_groups",
          "label": "total",
          "formatter": "number"
        }
      ]
    }
  },
